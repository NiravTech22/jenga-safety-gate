<!-- STAND-IN arm with SO-101-like kinematics/masses. Replace with your real twin MJCF
     (jenga-safety-gate/twin/...) and keep the joint names, or edit configs/so101.json. -->
<mujoco model="so101_standin">
  <compiler angle="radian"/>
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast"/>
  <worldbody>
    <geom type="plane" size="1 1 .1" rgba=".8 .8 .8 1"/>
    <body name="base" pos="0 0 0.03">
      <geom type="box" size=".05 .04 .03" mass="0.4"/>
      <body name="shoulder" pos="0 0 .05">
        <joint name="shoulder_pan" axis="0 0 1" range="-1.9 1.9" limited="true"/>
        <geom type="capsule" fromto="0 0 0 0 0 .04" size=".02" mass=".15"/>
        <body name="upper_arm" pos="0 0 .04">
          <joint name="shoulder_lift" axis="0 1 0" range="-1.9 1.9" limited="true"/>
          <geom type="capsule" fromto="0 0 0 0 0 .116" size=".018" mass=".12"/>
          <body name="forearm" pos="0 0 .116">
            <joint name="elbow_flex" axis="0 1 0" range="-1.9 1.9" limited="true"/>
            <geom type="capsule" fromto="0 0 0 0 0 .135" size=".016" mass=".10"/>
            <body name="wrist" pos="0 0 .135">
              <joint name="wrist_flex" axis="0 1 0" range="-1.9 1.9" limited="true"/>
              <geom type="capsule" fromto="0 0 0 0 0 .06" size=".015" mass=".08"/>
              <body name="gripper_link" pos="0 0 .06">
                <joint name="wrist_roll" axis="0 0 1" range="-3 3" limited="true"/>
                <geom type="box" pos="0 0 .04" size=".02 .03 .04" mass=".15"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
