__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Data and logs are generated, not source — real episode data belongs in
# Git LFS or external storage once Step 4 produces real recordings.
data/episodes/
data/reference_photos/
data/calibration/
data/validation/
data/validation_failures/
logs/
checkpoints/

# Local env / secrets
.env
*.local.yaml

.DS_Store

# Local virtualenv
.venv/
venv/

# Third-party robot assets (SO-ARM100 upstream, fetched not vendored)
data/assets/
data/mujoco_jenga/

# Imported source build products stay local.
vendor/motion_perception/*.exe
vendor/motion_perception/*.exp
vendor/motion_perception/*.lib

# SO-101 digital twin: only the custom-claw meshes are committed; upstream
# meshes come from scripts/tools/fetch_so101_assets.py. Generated scenes too.
twin/models/meshes/*
!twin/models/meshes/custom_claw_*.stl
twin/models/*.generated.xml
twin/models/*.bak

# MuJoCo writes this on solver warnings
MUJOCO_LOG.TXT
